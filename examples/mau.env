# The environment of mau-server that differs per deployment. Paths are as the container sees the configuration bucket.
# The owner-ID namespace, as in @owner:mau.example.com. No Matrix server is used.
MATRIX_SERVER_NAME=mau.example.com
AGENT_SERVICE_URL=https://mau.example.com/_agent-router/v1
# The addresses requests arrive from inside the container.
AGENT_TRUST_PROXY=loopback,linklocal,uniquelocal
# Attachments are kept in their own bucket, not in the container's state.
AGENT_BLOB_STORE=r2
AGENT_R2_ENDPOINT=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com
AGENT_R2_BUCKET=mau-attachments
AGENT_R2_ACCESS_KEY_ID_FILE=/config/r2-access-key-id
AGENT_R2_SECRET_ACCESS_KEY_FILE=/config/r2-secret-access-key
