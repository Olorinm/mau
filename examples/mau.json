{
  "environments": {
    "configFile": "providers.json",
    "profiles": [
      {
        "id": "cloud-codex",
        "label": "Personal cloud Agent",
        "owners": [
          "@alice:agents.example"
        ],
        "provider": "cloudflare",
        "template": "agent-host-tools",
        "kernel": "codex",
        "runtimeId": "personal",
        "hostConfigFile": "cloud/host-profile.json",
        "directory": "/home/user/.agent-host-service",
        "port": 37420,
        "lifetimeSeconds": 3600,
        "onTimeout": "kill",
        "files": [
          {
            "source": "/private/alice/codex-auth.json",
            "destination": "/home/user/.codex/auth.json"
          }
        ]
      }
    ]
  },
  "edgeIdentity": {
    "provider": "cloudflare-access",
    "teamDomain": "https://example-team.cloudflareaccess.com",
    "audiences": ["ACCESS_APPLICATION_AUDIENCE_TAG"],
    "owners": { "alice@example.com": "@alice:agents.example" }
  }
}
