{
  "name": "@olorinm/mau",
  "version": "0.1.0-alpha.6",
  "private": true,
  "description": "Mau: an agent product composed from Agent Router, Host and Environment.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Olorinm/mau.git"
  },
  "bin": {
    "mau": "dist/cli.js",
    "mau-server": "dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "files": [
    "dist",
    "web/dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "examples",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/ssh-environment.mjs dist/ssh-environment.mjs",
    "build:web": "npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:web": "npm run build:web && MAU_WEB_E2E=1 vitest run test/web-api.test.ts test/web-console.test.ts",
    "start": "node dist/main.js",
    "verify:packages": "npm run build && node scripts/verify-packages.mjs",
    "pack:cli": "npm run build && node scripts/pack-cli.mjs",
    "verify:cli": "npm run build && node scripts/verify-cli.mjs",
    "prepack": "npm run build 1>&2 && npm run build:web 1>&2"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@agent-router/server": "file:.packages/agent-router.tgz",
    "@olorinm/agent-environment": "file:.packages/agent-environment.tar",
    "@playwright/test": "1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@agent-router/server": "0.7.0-alpha.3",
    "@olorinm/agent-environment": "0.2.0-alpha.2"
  },
  "allowScripts": {
    "@larksuite/cli@1.0.97": true
  }
}
