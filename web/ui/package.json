{
  "name": "@olorinm/agent-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Mau console React components: chat and application primitives, and page layouts, with caller-owned data and operations",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent-host": {
      "types": "./dist/agent-host.d.ts",
      "import": "./dist/agent-host.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js"
    },
    "./app.css": "./dist/app/app.css",
    "./pages": {
      "types": "./dist/pages/index.d.ts",
      "import": "./dist/pages/index.js"
    },
    "./pages.css": "./dist/pages/pages.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.types.json && node scripts/types.mjs && node scripts/copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs test/pages/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs && node scripts/test-pages-browser.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@lezer/highlight": "^1.2.5",
    "@milkdown/crepe": "^7.22.2",
    "@milkdown/kit": "^7.22.1",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-slot": "1.4.0",
    "@vidstack/react": "1.15.7",
    "avvvatars-react": "0.4.2",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.8.0",
    "motion": "12.42.2",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "thinking-orbs": "0.3.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "postcss": "^8.5.30",
    "postcss-selector-parser": "^7.1.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.2",
    "vite": "8.3.3"
  }
}
