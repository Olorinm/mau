{
  "name": "@olorinm/agent-ui",
  "version": "0.1.0-alpha.1",
  "description": "Reusable React chat components with caller-owned data, tools and interactions",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Olorinm/agent-host.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent-host": {
      "types": "./dist/agent-host.d.ts",
      "import": "./dist/agent-host.js"
    },
    "./styles.css": "./dist/styles.css",
    "./thread.css": "./dist/thread.css",
    "./disclosure.css": "./dist/disclosure.css",
    "./cards.css": "./dist/cards.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-styles.mjs",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.8.0",
    "motion": "12.42.2",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
