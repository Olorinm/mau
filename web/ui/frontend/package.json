{
  "name": "@olorinm/agent-frontend",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Complete extracted OpenGrove frontend with a caller-owned service adapter.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Olorinm/agent-ui.git",
    "directory": "frontend"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "source-manifest.json",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./contracts.openapi.json": "./dist/contracts.openapi.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@lezer/highlight": "^1.2.5",
    "@lobehub/icons": "^5.23.0",
    "@milkdown/crepe": "^7.22.2",
    "@milkdown/kit": "^7.22.1",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@olorinm/agent-ui": "https://github.com/Olorinm/agent-ui/releases/download/v0.1.0-alpha.2/olorinm-agent-ui-0.1.0-alpha.2.tgz",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-popover": "1.2.0",
    "@rc-component/qrcode": "^1.1.3",
    "@tanstack/react-query": "^5.104.1",
    "@vidstack/react": "^1.15.7",
    "avvvatars-react": "^0.4.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.8.0",
    "motion": "^12.42.2",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "thinking-orbs": "0.3.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "vite": "^8.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@playwright/test": "1.63.0",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build && node scripts/declarations.mjs && node scripts/contracts.mjs",
    "dev": "vite --config vite.preview.config.ts",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:package": "node scripts/test-package.mjs",
    "prepack": "npm run build 1>&2"
  }
}
